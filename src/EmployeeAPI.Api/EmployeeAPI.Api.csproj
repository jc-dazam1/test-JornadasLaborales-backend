<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<GenerateOpenApiDocument>false</GenerateOpenApiDocument>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\EmployeeAPI.Application\EmployeeAPI.Application.csproj" />
	<ProjectReference Include="..\EmployeeAPI.Infrastructure\EmployeeAPI.Infrastructure.csproj" />
  </ItemGroup>

</Project>
